# Set by Heroku Postgres addon automatically in production; set manually for local dev
DATABASE_URL=postgres://localhost:5432/heroku_metrics

# Shared secret required as ?token=... on the /log-drain URL. Leave unset locally to skip the check.
DRAIN_TOKEN=

# Name of the Heroku app being monitored, and the fallback app_name used for
# any drain that doesn't pass ?app=<name> on its URL (see README for
# monitoring more than one app from a single deployment).
MONITORED_APP_NAME=my-app

# Optional: a Heroku OAuth token with the "read" scope only, used solely to
# list apps you can see (GET /apps) so the dashboard's App dropdown can
# suggest apps that aren't monitored yet. Never used for anything but reads.
# Create one with: heroku authorizations:create --scope read -d "metrics-app discovery"
HEROKU_API_KEY=

PORT=3000
